      <children xsi:type="archimate:DiagramObject" id="id-do-v1-C0" targetConnections="id-conn-v1-r20 id-conn-v1-r21 id-conn-v1-r22 id-conn-v1-r30" archimateElement="id-C0" fillColor="#B5FFFF">
        <bounds x="28" y="252" width="810" height="72"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-conn-v1-r10" source="id-do-v1-C0" target="id-do-v1-B3" archimateRelationship="id-r10"/>
