  </folder>
  <folder name="Views" id="id-folder-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="1. Обзор" id="id-view-v1">
      <documentation>Кто чем пользуется: игрок и разработчик баланса, клиент, три службы REST, сервер и то, на чём всё стоит.</documentation>
      <children xsi:type="archimate:DiagramObject" id="id-do-v1-B1" archimateElement="id-B1" fillColor="#FFFFB5">
        <bounds x="343" y="28" width="180" height="72"/>
