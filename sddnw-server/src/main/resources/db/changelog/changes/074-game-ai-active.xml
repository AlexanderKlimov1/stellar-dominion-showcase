<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Признак партии «ИИ действует» (трек техдолга, пункт 17). Выключают его сценарии
      сквозного прогона, где два человека водят одинокие корабли навстречу друг другу: живой
      сосед перехватывал курьера и отнимал родной мир, и проверки плавали. Старым партиям
      ставится `true` — как в игре и должно быть.
    -->
    <changeSet id="074-game-ai-active" author="sddnw">
        <addColumn tableName="game">
            <column name="ai_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
