<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Заглушки по пунктам 5, 6, 8 и 10: спецификация даёт только заголовки разделов,
        поэтому здесь минимальный набор строк, достаточный для запуска игры на 8 игроков.
        Детализация добавляется новыми changeSet без изменения структуры таблиц.
    -->

