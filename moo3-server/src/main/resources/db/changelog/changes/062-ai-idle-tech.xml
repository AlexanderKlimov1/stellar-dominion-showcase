<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Память о безделье — у КОЛОНИИ, а не у империи (п. 15, п. 10).

      Правка 061 держала это число у игрока: «сколько технологий было, когда ИИ последний
      раз пересматривал стройку». И она была НЕВЕРНА, причём ровно по правилу самой игры:
      пустой стройки у колонии не остаётся — достроив здание, колония переходит на ТОВАРЫ.
      А товары для ИИ значат «свободна». Пропуск по признаку империи поэтому ловил как раз
      тех, кто только что достроил и ждёт нового дела: колония простаивала на товарах до
      тех пор, пока империя чему-нибудь не научится. Замер это и показал — фаза
      производства подешевела втрое, потому что строить стало почти нечего.

      Здесь число лежит у самой колонии и значит другое: «я смотрела список при стольких
      технологиях и не нашла ничего». Освободившаяся колония такого следа не несёт и
      смотрит список сразу, а колония, которой строить нечего, молчит до новой технологии.
      Пусто значит «смотреть надо».

      Поле игрока (061) больше не нужно: колонии знают за себя.
    -->
    <changeSet id="062-ai-idle-tech" author="moo3">
        <addColumn tableName="planet">
            <column name="ai_idle_tech" type="integer"/>
        </addColumn>
        <dropColumn tableName="player" columnName="ai_tech_seen"/>
    </changeSet>

</databaseChangeLog>
