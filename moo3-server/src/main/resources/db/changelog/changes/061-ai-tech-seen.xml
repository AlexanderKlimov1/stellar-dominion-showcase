<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Сколько технологий было у империи ИИ, когда она последний раз пересматривала список
      стройки своих колоний — п. 15, п. 10.

      Зачем поле. Фаза ИИ съедает ПОЛОВИНУ конца хода (замер: 51 %, 81 мс из 159), и
      главная трата внутри неё — полный список стройки, который собирался для каждой
      свободной колонии каждой империи КАЖДЫЙ ХОД. Занятая колония пропускалась и раньше,
      но колония, которой строить уже нечего, вечно стоит на товарах, а товары считаются
      «свободна»: список для неё пересобирался до конца партии, чтобы каждый раз не найти
      ничего нового. Список же меняется от изученного — новая технология открывает здание
      или корпус, — поэтому пересматривать его имеет смысл тогда, когда империя чему-то
      научилась.

      Почему в базе, а не в памяти сервиса. Балансовый прогон считает десять партий разом
      одним сервером, и общая карта «игрок → что он видел» жила бы у всех партий сразу.
      Любое вытеснение из неё зависело бы от того, как переплелись потоки, а партия обязана
      повторяться до последнего числа (иначе парные прогоны сравнивают не расы, а удачу).
      Поле игрока от потоков не зависит и умирает вместе с партией.

      Пусто значит «ещё не смотрел»: у новой империи список соберётся в первый же ход.
    -->
    <changeSet id="061-ai-tech-seen" author="moo3">
        <addColumn tableName="player">
            <column name="ai_tech_seen" type="integer"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
