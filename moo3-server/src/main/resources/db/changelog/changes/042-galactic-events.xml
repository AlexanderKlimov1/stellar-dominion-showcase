<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Случайные галактические события — п. 11.1.

        В MOO II это «удачи, беды и напасти, случившиеся не по вине игрока», и там же, в
        окне новой игры, их можно выключить. Значит, признак принадлежит партии, а не
        настройкам сервера: в одной партии события идут, в соседней их нет, и загруженное
        сохранение должно помнить, как играли.

        По умолчанию включены — как и в оригинале.
    -->
    <changeSet id="042-01-galactic-events" author="moo3">
        <addColumn tableName="game">
            <column name="galactic_events" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
