<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Язык игрока живёт в его учётной записи — п. 3.5.

      До этого язык лежал только в localStorage браузера: игрок выбирал русский, садился за
      другую машину — и получал английский заново. Запись переживает и браузер, и машину,
      поэтому язык хранится здесь, а localStorage остаётся быстрым ответом на вопрос «на
      каком языке рисовать первый экран, пока пропуск ещё не проверен».

      Колонка НЕ обязательная: пусто значит «игрок языка не называл», и тогда решает
      браузер. Пустой она остаётся и у администратора — его заводит первый запуск сервера,
      где никакого запроса, а значит и языка, нет вовсе.
    -->
    <changeSet id="067-account-locale" author="moo3">
        <addColumn tableName="account">
            <column name="locale" type="varchar(8)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
