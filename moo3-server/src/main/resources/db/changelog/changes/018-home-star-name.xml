<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Название родной звезды, выбранное игроком при создании игры или входе в чужую.
        Колонка необязательна: без своего названия родная система получает имя из
        справочника звёзд, как и все остальные.
    -->
    <changeSet id="018-01-add-player-home-star-name" author="moo3">
        <addColumn tableName="player">
            <column name="home_star_name" type="VARCHAR(64)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
